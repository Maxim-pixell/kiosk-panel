{
  "manifest_version": 3,
  "name": "Kiosk buttons",
  "version": "1.2",
  "options_page": "options.html",
  "description": "Navigation buttons for kiosok mode",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kiosk-buttons1@yourdomain.org",
      "strict_min_version": "115.28"
    }
  }
}