{
  "manifest_version": 3,
  "name": "Kiosk buttons",
  "version": "1.1",
  "options_page": "options.html",
  "description": "Navigation buttons for kiosok mode",
  "permissions": [
    "activeTab",
    "tabs",
    "*://*/*",
    "storage"
  ],
  "optional_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
  "gecko": {
    "id": "kiosk-buttons@yourdomain.org",
    "strict_min_version": "109.0",
    "data_collection_permissions": {
      "required": ["none"]
      }
    }
  }
}